---
title: "Lab 3 – Part 2 – Place an order | David Kasozi Saaka | CS590DE Software Design Engineering | 2026-09-27"
---
sequenceDiagram
    autonumber
    actor User
    participant SS as :ShoppingService
    participant OS as :OrderService
    participant CS as :CustomerService
    participant O as :Order
    participant SCC as :ShippingCostCalculator
    participant DAO as :OrderDAO
    participant EH as :OrderPlacedEventHandler
    participant ES as :EmailSender

    User->>SS: checkoutCart()
    SS->>OS: createOrder(shoppingCart)
    OS->>CS: getLoggedOnCustomer()
    CS-->>OS: customer
    OS->>O: <<create>> Order(customer, orderLines)
    O-->>OS: order

    User->>OS: shipTo(address)
    OS->>O: shipTo(address)

    User->>OS: billTo(address)
    OS->>O: billTo(address)

    User->>OS: chooseShipping(shippingOption)
    OS->>SCC: calculate(order, address, shippingOption)
    SCC-->>OS: shippingCost
    OS->>O: chooseShipping(shippingOption, shippingCost)

    User->>OS: payWith(creditCard)
    OS->>O: payWith(creditCard)

    User->>OS: confirm()
    OS->>O: confirm()
    O->>O: computeTotal()
    OS->>DAO: save(order)

    OS-)EH: <<domain event>> OrderPlacedEvent
    EH->>ES: send(customer.email, "Order confirmation")

    OS-->>User: orderNumber
