<?xml version="1.0" encoding="UTF-8"?>
<beans:beans xmlns="http://www.springframework.org/schema/integration"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:beans="http://www.springframework.org/schema/beans"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
			http://www.springframework.org/schema/beans/spring-beans.xsd
			http://www.springframework.org/schema/integration
			http://www.springframework.org/schema/integration/spring-integration.xsd">

	<!-- ============================ CHANNELS ============================ -->
	<channel id="warehousechannel"/>      <!-- OrderController   -> warehouse  -->
	<channel id="ordertypechannel"/>      <!-- warehouse         -> router 1   -->
	<channel id="domesticchannel"/>       <!-- router 1          -> router 2   -->
	<channel id="internationalchannel"/>  <!-- router 1          -> int.ship   -->
	<channel id="nextdaychannel"/>        <!-- router 2          -> next day   -->
	<channel id="normalchannel"/>         <!-- router 2          -> normal     -->

	<!-- Every order is checked by the warehouse first, then handed to router 1 -->
	<service-activator input-channel="warehousechannel"
	                   output-channel="ordertypechannel"
	                   ref="warehouseservice"
	                   method="checkStock"/>

	<!-- ===== ROUTER 1 (part b): on order type ===== -->
	<router input-channel="ordertypechannel"
	        ref="orderTypeRouter"
	        method="route"/>

	<!-- ===== ROUTER 2 (part a): on amount, domestic orders only ===== -->
	<router input-channel="domesticchannel"
	        ref="amountRouter"
	        method="route"/>

	<!-- ============================ ENDPOINTS ============================ -->
	<service-activator input-channel="internationalchannel"
	                   ref="internationalshippingservice"
	                   method="ship"/>

	<service-activator input-channel="nextdaychannel"
	                   ref="nextdayshippingservice"
	                   method="ship"/>

	<service-activator input-channel="normalchannel"
	                   ref="normalshippingservice"
	                   method="ship"/>

	<!-- ============================== BEANS ============================== -->
	<beans:bean id="warehouseservice"              class="esb.WarehouseActivator"/>
	<beans:bean id="orderTypeRouter"               class="esb.OrderTypeRouter"/>
	<beans:bean id="amountRouter"                  class="esb.AmountRouter"/>
	<beans:bean id="internationalshippingservice"  class="esb.InternationalShippingActivator"/>
	<beans:bean id="nextdayshippingservice"        class="esb.NextDayShippingActivator"/>
	<beans:bean id="normalshippingservice"         class="esb.NormalShippingActivator"/>

</beans:beans>
